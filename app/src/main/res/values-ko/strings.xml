    <!-- Settings Explanations -->
    <string name="setting_explanation_ask_redirection">웹페이지가 다른 도메인으로 리디렉션하기 전에 확인 대화상자를 표시합니다.</string>
    <string name="setting_explanation_interrupt_intercepted">다운로드용으로 감지된 미디어 스트림이 웹페이지에서 직접 로드되거나 재생되는 것을 중지합니다.</string>
    <string name="setting_explanation_show_video_alert">웹페이지에서 다운로드 가능한 비디오가 감지될 때마다 자동 팝업 알림 대화상자를 표시합니다.</string>
    <string name="setting_explanation_show_action_button">다운로드 가능한 미디어가 발견되면 브라우저 화면에 플로팅 다운로드 버튼을 표시합니다.</string>
    <string name="setting_explanation_find_videos_by_url">웹페이지 URL을 직접 스캔하여 포함된 비디오 및 미디어 링크를 찾습니다.</string>
    <string name="setting_explanation_check_every_mp4">웹페이지가 전송하는 모든 네트워크 요청을 모니터링하여 다운로드 가능한 MP4 비디오 파일을 감지합니다.</string>
    <string name="setting_explanation_check_every_m3u8">HLS (M3U8) 및 DASH (MPD) 비디오 스트리밍 재생목록에 대한 네트워크 요청을 모니터링합니다.</string>
    <string name="setting_explanation_check_every_audio">네트워크 요청을 모니터링하여 웹페이지의 오디오 스트림 및 사운드 파일을 감지합니다.</string>
    <string name="setting_explanation_force_stream_detection">콘텐츠 길이 헤더가 알 수 없거나 누락된 미디어 스트림의 감지를 강제합니다(라이브 스트림에서 주로 사용됨).</string>
    <string name="setting_explanation_use_legacy_m3u8_detection">youtube-dlp 엔진을 사용하여 웹페이지에서 M3U8 및 MPD 스트리밍 비디오 링크를 추출합니다. (그렇지 않으면 SuperX 감지기가 사용됩니다)</string>
    <string name="setting_explanation_adblock_settings">광고 차단 필터 목록 및 사용자 정의 차단 규칙을 관리하기 위한 설정을 엽니다.</string>
    <string name="setting_explanation_ads_treshold">감지된 미디어 파일이 이 크기 임계값보다 작으면 무시하여 비디오 광고가 다운로드 가능한 콘텐츠로 감지되는 것을 방지합니다.</string>
    <string name="setting_explanation_download_subtitles">youtube-dlp를 사용하여 비디오를 다운로드할 때 사용 가능한 자막 트랙을 자동으로 가져와 저장합니다.</string>
    <string name="setting_explanation_force_stream_downloading">라이브 비디오 스트림과 같은 일반 (MP4) 비디오(M3U8/MPD 아님)에 대해 연속 스트림 다운로드를 활성화합니다(손상된 MP4 다운로드 일부를 수정할 수 있음).</string>
    <string name="setting_explanation_always_remux_regular">다운로드 완료 후 FFmpeg로 일반 MP4 파일을 처리하여 비디오 헤더, 타임스탬프, 컨테이너 형식을 수정합니다.</string>
    <string name="setting_explanation_remux_only_live">녹화된 라이브 스트림 다운로드에만 FFmpeg 후처리를 적용하여 올바른 비디오 탐색 및 재생 시간을 보장합니다.</string>
    <string name="setting_explanation_regular_threads">일반 파일에 대한 병렬 다운로드 스레드 수를 설정합니다. 스레드 수가 많으면 속도가 빨라질 수 있지만 일부 서버에서 손상을 유발할 수 있습니다.</string>
    <string name="setting_explanation_m3u8_threads">M3U8/HLS 스트리밍 비디오의 세그먼트 청크를 다운로드하는 데 사용되는 병렬 스레드 수를 설정합니다.</string>
    <string name="setting_explanation_downloads_location">다운로드한 비디오의 저장 폴더를 선택합니다: 공개 다운로드 폴더, 내부 저장소 내의 비공개 숨김 폴더 또는 SD 카드 저장소.</string>

    <string name="advanced_guide">고급 가이드</string>
    <string name="advanced_guide_title">고급 감지 가이드</string>
    <string name="advanced_guide_text">SuperX에는 3가지 종류의 비디오 감지 엔진이 있습니다:\n\n1. URL별 감지:\n웹페이지 URL을 직접 스캔합니다. 비디오 URL이 웹 링크에 포함된 Facebook이나 TikTok 같은 사이트에 이상적입니다.\n\n2. 일반 파일 감지:\nMP4, WebM, 오디오 등 직접적인 미디어 파일에 대한 네트워크 요청을 검사합니다.\n\n3. M3U8 / MPD 스트리밍 감지:\n스트리밍 재생목록(HLS / DASH)을 감지합니다. 두 가지 변형이 제공됩니다:\n • youtube-dlp 엔진: 매우 안정적이고 신뢰할 수 있지만 약간 느립니다.\n • SuperX 감지기: 새롭고 실험적이며 극도로 빠릅니다(1초 미만).\n\n특정 웹사이트에 맞게 최적화하는 방법:\n기본적으로 모든 감지기가 활성화되어 있습니다. 설정에서 특정 사이트에 맞게 미세 조정할 수 있습니다:\n • Facebook 또는 TikTok의 경우(URL로만 감지가 작동함): 일반 파일 감지 및 M3U8/MPD 감지를 끌 수 있습니다.\n • 스트리밍 사이트의 경우(네트워크 요청을 가로채서 감지가 작동함): URL 감지를 끌 수 있습니다.\n • 메뉴의 \'감지 로그\'를 확인하여 어떤 감지기가 비디오를 찾고 있는지 확인하고, 사용하지 않는 감지기를 꺼서 더 빠른 성능을 얻을 수 있습니다!</string>
</resources>
